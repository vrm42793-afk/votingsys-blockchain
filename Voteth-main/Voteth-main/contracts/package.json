{
  "name": "voteth-contracts",
  "private": true,
  "version": "0.1.0",
  "description": "VotEth 2.0 — Solidity smart contracts + Hardhat toolchain",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "deploy:amoy": "hardhat ignition deploy ./ignition/modules/VotEthDeploy.ts --network amoy",
    "deploy:sepolia": "hardhat ignition deploy ./ignition/modules/VotEthDeploy.ts --network sepolia",
    "deploy:sepolia:script": "hardhat run scripts/deploy-sepolia.ts --network sepolia",
    "deploy:localhost": "hardhat ignition deploy ./ignition/modules/VotEthDeploy.ts --network localhost",
    "verify": "hardhat verify --network amoy",
    "verify:sepolia": "hardhat verify --network sepolia",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "lint": "solhint 'contracts/**/*.sol'",
    "size": "hardhat size-contracts",
    "gas-report": "REPORT_GAS=true hardhat test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "hardhat": "^2.22.0",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.8",
    "solhint": "^5.0.0",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.1",
    "typescript": "^6.0.3"
  }
}
